# Copy this file to .env and adjust for your machine
PORT=5000

# Either use a full connection string...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/university_ems

# ...or set the individual pieces below (they are ignored if DATABASE_URL is set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=university_ems

# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
